(footprint "NetTie_NFC_Loop" (version 20221018) (generator hallrfid)
  (layer "F.Cu")
  (descr "Net tie of an NFC loop drawn on the board: pad 1 at the origin (the end of the top-side turns), pad 2 one step along -x (the inner end, net of the back-side bridge); the pads are joined by footprint copper, KiCad's net_tie_pad_groups makes it legal")
  (tags "net tie NFC loop")
  (attr smd exclude_from_pos_files exclude_from_bom)
  (net_tie_pad_groups "1, 2")
  (fp_text reference "REF**" (at -0.75 -1.3) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text value "NetTie_NFC_Loop" (at -0.75 1.3) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_poly
    (pts
      (xy -1.1 -0.2)
      (xy -0.4 -0.2)
      (xy -0.4 0.2)
      (xy -1.1 0.2)
    )
    (stroke (width 0) (type solid)) (fill solid) (layer "F.Cu"))
  (fp_line (start -2.1 -0.6) (end 0.6 -0.6) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 0.6 -0.6) (end 0.6 0.6) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 0.6 0.6) (end -2.1 0.6) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -2.1 0.6) (end -2.1 -0.6) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu"))
  (pad "2" smd rect (at -1.5 0) (size 1 1) (layers "F.Cu"))
)
